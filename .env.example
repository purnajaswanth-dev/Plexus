# ==============================================================================
# CodeCity SaaS Platform — Environment Configuration Template
# Copy this file to .env and provide your actual secrets.
# NEVER commit the .env file containing real credentials!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon PostgreSQL Database Configuration
# Direct Connection (Migrations / DDL):
#   jdbc:postgresql://<neon-hostname>:5432/<dbname>?sslmode=require
# Pooled Connection (Application Runtime):
#   jdbc:postgresql://<neon-hostname>-pooler:5432/<dbname>?sslmode=require
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here

# ------------------------------------------------------------------------------
# 2. Supabase Authentication & Resource Server Configuration
# Project URL: https://<project-ref>.supabase.co
# JWKS URI: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Issuer URI: https://<project-ref>.supabase.co/auth/v1
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_ISSUER_URI=https://your-project-id.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_EXPECTED_AUDIENCE=authenticated

# ------------------------------------------------------------------------------
# 3. Frontend Client Environment Variables
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key_here
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 4. Optional GitHub Integration Token (Fallback for Public Repo Higher Rate Limit)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=

